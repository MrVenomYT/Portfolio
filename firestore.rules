rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio Data Collections - public read, write enabled for admin & management
    match /portfolio_profile/{docId} {
      allow read, write: if true;
    }
    match /portfolio_projects/{docId} {
      allow read, write: if true;
    }
    match /portfolio_products/{docId} {
      allow read, write: if true;
    }
    match /portfolio_services/{docId} {
      allow read, write: if true;
    }
    match /portfolio_education/{docId} {
      allow read, write: if true;
    }
    match /portfolio_experiences/{docId} {
      allow read, write: if true;
    }
    match /portfolio_certifications/{docId} {
      allow read, write: if true;
    }
    match /portfolio_skills/{docId} {
      allow read, write: if true;
    }
    match /portfolio_testimonials/{docId} {
      allow read, write: if true;
    }
    match /portfolio_faqs/{docId} {
      allow read, write: if true;
    }
    match /contact_inquiries/{inquiryId} {
      allow read, write: if true;
    }
    match /guestbook/{entryId} {
      allow read, write: if true;
    }
    match /project_reviews/{reviewId} {
      allow read, write: if true;
    }
  }
}
